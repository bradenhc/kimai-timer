{
  "markdown": {
    "lineWidth": 80,
    "textWrap": "always"
  },
  "toml": {},
  "excludes": [
    // Hard-wrapped lines show up as line breaks in pull request descriptions.
    ".github/pull_request_template.md"
  ],
  "plugins": [
    "https://plugins.dprint.dev/markdown-0.21.1.wasm",
    "https://plugins.dprint.dev/toml-0.7.0.wasm"
  ]
}
